{
  "name": "app-escuela-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch ./src/index.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env ./src/db/migrate.ts",
    "db:test:migrate": "tsx --env-file=.env.test ./src/db/migrate.ts",
    "bootstrap:admin": "tsx --env-file=.env ./src/scripts/bootstrap-admin.ts",
    "compose": "docker compose up -d",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:test:up": "docker compose --env-file .env.test --profile test up -d postgres-test",
    "compose:test:down": "docker compose --env-file .env.test --profile test stop postgres-test",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
